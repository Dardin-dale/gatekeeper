*.js
!jest.config.js
!test/*.test.js
!test/**/*.test.js
# Allow CLI JavaScript files
!cli/**/*.js
!register-commands.js
# Allow bin directory scripts
!bin/*.js
# Allow hand-written JS modules in lib/ (compiled .ts output stays gitignored via dist/)
!lib/discord-commands.js
# Allow the hand-written A2S query helper (dependency-free, run with plain node)
!scripts/game/a2s-query.js
# Allow module JavaScript files (.mjs)
!*.mjs
*.d.ts
dist/
node_modules
.env
gatekeeper-config.json

# Local per-game world config & secrets (world names, passwords, Discord IDs).
# These never go in git — committed templates use the *.example.json suffix instead.
config/*.worlds.json
config/*.discord.json
config/*.local.json

# WSL download metadata sidecars
*:Zone.Identifier

# CDK asset staging directory
.cdk.staging
cdk.out
cdk-outputs.json

# Parcel default cache directory
.parcel-cache

# Valheim world files and mods
/worlds/*
!/worlds/.gitkeep
/mods/*
!/mods/.gitkeep
/backups/*
!/backups/.gitkeep

**/.claude/settings.local.json
cdk.out

# Log files
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
deploy.log

# Local testing data
test-data/
test-mods/
scripts/local-test.sh

# Local AF server data (downloaded game + saves from docker-compose.local.yml)
/local/

# Test coverage output
coverage/

# Jest snapshots: regenerated locally (CDK template snapshots can embed config
# values like WORLDS_JSON, so they stay out of git).
**/__snapshots__/

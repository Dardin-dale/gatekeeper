# ============================================================================
# GATEKEEPER CONFIGURATION
# ============================================================================
# Copy this file to .env and fill in your values. .env is gitignored — never
# commit real tokens. Detailed setup: docs/discord-setup.md, docs/aws-setup.md
#
# QUICK START:
#   1. AWS:     aws configure   (and set AWS_REGION below)
#   2. Discord: create an app at https://discord.com/developers/applications;
#               set the 3 DISCORD_* values below (or in config/<game>.discord.json)
#   3. Worlds:  cp config/abiotic-factor.worlds.example.json config/abiotic-factor.worlds.json
#               (then edit it — worlds + passwords live there, NOT here)
#   4. Deploy:  source .env && npm run deploy   then   npm run register-commands
# ============================================================================

# === GAME SELECTION ===
# Which game profile to deploy. Drives the stack name (GateStack-AbioticFactor),
# the SSM subtree (/gatekeeper/<game>/...), Docker image, ports and instance size.
GAME=abiotic-factor

# === AWS ===
AWS_REGION=us-west-2
AWS_PROFILE=default

# === BASE DOMAIN (OPTIONAL) — ROUTE 53 ===
# Set your bare domain ONCE; each game derives its own subdomain record
# (e.g. abiotic.<BASE_DOMAIN>) in the one shared hosted zone. Requires the domain
# to be in Route 53 (~$0.50/mo). Leave unset to just use the server's public IP.
# BASE_DOMAIN=example.net          # Abiotic Factor -> abiotic.example.net:7777

# === SCHEDULE TIMEZONE (OPTIONAL) ===
# IANA timezone used to interpret `/gate schedule set when:` input (display uses
# Discord-native timestamps, which render in each viewer's local time anyway).
# SCHEDULE_TZ=America/Los_Angeles  # the default

# === BILLING ALERT (OPTIONAL) ===
# Email to create an AWS Budget that warns when monthly spend trends past the
# threshold (80% actual + a forecast to exceed 100%). Account-wide — set it above
# your normal total. Leave the email unset to skip the budget.
# BILLING_ALERT_EMAIL=you@example.com
# BILLING_BUDGET_USD=25

# === COST / RUNTIME ===
# Auto-shutdown: minutes of zero players before the server stops itself.
# 'off' / 'disabled' keeps it running. Default 20.
AUTO_SHUTDOWN_MINUTES=20
# Boot-timeout: minutes to wait for the server to come online before stopping a
# failed boot (so a wedged first boot can't bill forever). 'off' to disable. Default 45.
BOOT_TIMEOUT_MINUTES=45
# EC2 instance type (you only pay while running). AF runs under Wine — needs headroom:
#   t3.large ~$0.08/hr (1-4 players, recommended) · t3.xlarge ~$0.17/hr (5-8) · t3.2xlarge ~$0.33/hr (8+)
INSTANCE_TYPE=t3.large
# How many S3 backups to keep per game.
BACKUPS_TO_KEEP=7

# === WORLDS ===
# Worlds + passwords are NOT set here — they live in a gitignored per-game file:
#   config/<game>.worlds.json   (copy from config/<game>.worlds.example.json)
# Each entry: { name, worldName, serverPassword, discordServerId, default? }.

# === DISCORD (REQUIRED) ===
# Create a NEW Discord application for this game's bot (one app per game).
# From https://discord.com/developers/applications:
#   APP_ID      General Information > Application ID
#   PUBLIC_KEY  General Information > Public Key  (verifies inbound requests)
#   TOKEN       Bot > Reset Token > Copy
# Invite perms: View Channels + Send Messages + Manage Webhooks. Intents: all OFF.
# These may instead live in config/<game>.discord.json (per-game). Never commit them.
DISCORD_APP_ID=123456789012345678
DISCORD_BOT_PUBLIC_KEY=abcdef1234567890abcdef1234567890abcdef1234567890abcdef1234567890
DISCORD_BOT_SECRET_TOKEN=your-discord-bot-token-here
